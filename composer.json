{
    "name": "zana/queue",
    "description": "Queue abstraction for background jobs in Zana applications",
    "type": "library",
    "keywords": ["zana", "queue", "jobs", "background"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Queue\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

