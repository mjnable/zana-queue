{
    "name": "mj-zana/queue",
    "description": "Background jobs for Zana applications: in-memory, database and sync queues, a scoped worker, retries and failure storage",
    "type": "library",
    "keywords": ["zana", "queue", "jobs", "background", "worker"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/console": "^2.0",
        "mj-zana/core": "^2.0",
        "mj-zana/database": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Queue\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.0.0" } } },
        { "type": "path", "url": "../zana-console", "options": { "symlink": true, "versions": { "mj-zana/console": "2.0.0" } } },
        { "type": "path", "url": "../zana-ddd", "options": { "symlink": true, "versions": { "mj-zana/ddd": "2.0.0" } } },
        { "type": "path", "url": "../zana-database", "options": { "symlink": true, "versions": { "mj-zana/database": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
